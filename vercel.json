{
  "version": 2,
  "builds": [
    {
      "src": "predict.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(plots|static)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/(health|metadata|predict/.*|api/.*)",
      "dest": "predict.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ]
}

